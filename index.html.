<div id="mod-shares" class="module hidden"><h1 class="text-xl font-black mb-4">Shares</h1><div class="bg-white p-4 rounded-xl shadow mb-4 grid grid-cols-1 md:grid-cols-4 gap-2"><select id="shareMember" class="border p-2 rounded"></select><input id="shareQty" type="number" placeholder="Qty" class="border p-2 rounded"><input id="sharePrice" type="number" value="20000" class="border p-2 rounded"><button onclick="addShare()" class="bg-yellow-600 text-white rounded p-2 font-bold">Buy</button></div><div class="bg-white rounded-xl shadow overflow-auto"><table class="w-full text-sm"><thead class="bg-gray-100"><tr><th class="p-2">Member</th><th class="p-2">Shares</th><th class="p-2">Total</th><th class="p-2">Actions</th></tr></thead><tbody id="shareTable"></tbody></table></div></div>
<div id="mod-savings" class="module hidden"><h1 class="text-xl font-black mb-4">Savings</h1><div class="bg-white p-4 rounded-xl shadow mb-4 grid grid-cols-1 md:grid-cols-4 gap-2"><select id="savMember" class="border p-2 rounded"></select><select id="savType" class="border p-2 rounded"><option>Compulsory</option><option>Voluntary</option><option>Fixed Deposit</option></select><input id="savAmount" type="number" placeholder="Amount" class="border p-2 rounded"><button onclick="addSaving()" class="bg-green-600 text-white rounded p-2 font-bold">Save</button></div><div class="bg-white rounded-xl shadow overflow-auto"><table class="w-full text-sm"><thead class="bg-gray-100"><tr><th class="p-2">Member</th><th class="p-2">Type</th><th class="p-2">Amount</th><th class="p-2">Actions</th></tr></thead><tbody id="savTable"></tbody></table></div></div>
<div id="mod-loans" class="module hidden"><h1 class="text-xl font-black mb-4">Loans</h1><div class="bg-white p-4 rounded-xl shadow mb-4 grid grid-cols-1 md:grid-cols-5 gap-2"><select id="loanMember" class="border p-2 rounded"></select><select id="loanType" class="border p-2 rounded"><option>Emergency</option><option>Business</option><option>School Fees</option><option>Agriculture</option><option>Boda Loan</option><option>Salary Loan</option></select><input id="loanAmount" type="number" placeholder="Amount" class="border p-2 rounded"><input id="loanRate" type="number" value="10" class="border p-2 rounded"><input id="loanDuration" type="number" placeholder="Months" class="border p-2 rounded"></div><div class="bg-white p-4 rounded-xl shadow mb-4 grid grid-cols-1 md:grid-cols-3 gap-2"><input id="loanGuarantor" placeholder="Guarantors" class="border p-2 rounded"><input id="loanCollateral" placeholder="Collateral" class="border p-2 rounded"><button onclick="addLoan()" class="bg-yellow-600 text-white rounded p-2 font-bold">Apply</button></div><div class="bg-white rounded-xl shadow overflow-auto"><table class="w-full text-sm"><thead class="bg-gray-100"><tr><th class="p-2">Loan-Member</th><th class="p-2">Type</th><th class="p-2">Amount</th><th class="p-2">Actions</th></tr></thead><tbody id="loanTable"></tbody></table></div></div>
<div id="mod-repay" class="module hidden"><h1 class="text-xl font-black mb-4">Repayments</h1><div class="bg-white p-4 rounded-xl shadow mb-4 grid grid-cols-1 md:grid-cols-3 gap-2"><select id="repayLoan" class="border p-2 rounded"></select><input id="repayAmount" type="number" placeholder="Amount" class="border p-2 rounded"><button onclick="addRepay()" class="bg-green-600 text-white rounded p-2 font-bold">Pay</button></div><div class="bg-white rounded-xl shadow overflow-auto"><table class="w-full text-sm"><thead class="bg-gray-100"><tr><th class="p-2">Loan-Member</th><th class="p-2">Paid</th><th class="p-2">Date</th><th class="p-2">Actions</th></tr></thead><tbody id="repayTable"></tbody></table></div></div>
<div id="mod-expenses" class="module hidden"><h1 class="text-xl font-black mb-4">Expenses</h1><div class="bg-white p-4 rounded-xl shadow mb-4 grid grid-cols-1 md:grid-cols-3 gap-2"><input id="expTitle" placeholder="Title" class="border p-2 rounded"><input id="expAmount" type="number" placeholder="Amount" class="border p-2 rounded"><button onclick="addExpense()" class="bg-red-600 text-white rounded p-2 font-bold">Save</button></div><div class="bg-white rounded-xl shadow overflow-auto"><table class="w-full text-sm"><thead class="bg-gray-100"><tr><th class="p-2">Title</th><th class="p-2">Amount</th><th class="p-2">Date</th><th class="p-2">Actions</th></tr></thead><tbody id="expTable"></tbody></table></div></div>
<div id="mod-statement" class="module hidden"><h1 class="text-xl font-black mb-4">Statement</h1><div class="grid grid-cols-1 md:grid-cols-3 gap-4"><div class="bg-green-600 text-white p-4 rounded-xl"><p class="text-xs">Income</p><p id="stIncome" class="text-2xl font-black">UGX 0</p></div><div class="bg-red-600 text-white p-4 rounded-xl"><p class="text-xs">Expenses</p><p id="stExp" class="text-2xl font-black">UGX 0</p></div><div class="bg-blue-900 text-white p-4 rounded-xl"><p class="text-xs">Profit</p><p id="stProfit" class="text-2xl font-black">UGX 0</p></div></div></div>
<div id="mod-reports" class="module hidden"><h1 class="text-xl font-black mb-4">Reports</h1><div id="reportsArea" class="bg-white p-4 rounded-xl shadow text-sm"></div></div>
<div id="mod-share" class="module hidden"><h1 class="text-xl font-black mb-4">Share</h1><div class="bg-white p-6 rounded-xl shadow text-center"><div class="bg-gray-100 p-3 rounded font-mono text-sm break-all mb-4">https://allan128ug.github.io/sacco-management-system/</div></div></div>
</div>
</div>
</div>
<script>
const firebaseConfig = {
  apiKey: "AIzaSyC1ThlpMYpb5D3A5Kt0v9P-Ou_nQgHESKs",
  authDomain: "allan-sacco.firebaseapp.com",
  databaseURL: "https://allan-sacco-default-rtdb.firebaseio.com",
  projectId: "allan-sacco",
  storageBucket: "allan-sacco.firebasestorage.app",
  messagingSenderId: "953104778679",
  appId: "1:953104778679:web:580078814f13c4c61e9432"
};
const SUPER_ADMIN_EMAILS = ["allan128ug@gmail.com"];
let db=null,auth=null,currentUserData=null,store={members:[], shares:[], savings:[], loans:[], repayments:[], expenses:[], users:{}};
function initFirebase(){ try{ if(!firebase.apps.length) firebase.initializeApp(firebaseConfig); db=firebase.database(); auth=firebase.auth(); document.getElementById('fbStatus').innerHTML="🔒 V3.0 Secure Connected - allan-sacco"; document.getElementById('fbStatus').className="text-[11px] p-2 rounded mb-3 bg-green-100 text-green-700 text-center"; auth.onAuthStateChanged(user=>{ if(user) checkSuperAdmin(user); }); loadUsersForLogin(); }catch(e){} }
function toggleLoginType(){ let t=document.getElementById('loginType').value; document.getElementById('staffLogin').classList.toggle('hidden', t!=='staff'); document.getElementById('superLogin').classList.toggle('hidden', t!=='super'); }
function loadUsersForLogin(){ db.ref('users').once('value', snap=>{ store.users=snap.val()||{}; }); }
async function doSuperLogin(){ let email=document.getElementById('superEmail').value.trim(); let pass=document.getElementById('superPass').value.trim(); let err=document.getElementById('authError'); err.classList.add('hidden'); try{ await auth.signInWithEmailAndPassword(email,pass); logAction('SUPER_LOGIN','Super admin login: '+email); }catch(e){ err.textContent='Login failed: '+e.message; err.classList.remove('hidden'); } }
async function checkSuperAdmin(user){ try{ let snap=await db.ref('users/'+user.uid).once('value'); let data=snap.val(); if(!data){ let isSuper=SUPER_ADMIN_EMAILS.includes(user.email.toLowerCase()); if(!isSuper){ document.getElementById('authError').textContent='Not Super Admin'; document.getElementById('authError').classList.remove('hidden'); auth.signOut(); return; } data={name:user.email.split('@')[0], actualName:user.email.split('@')[0], email:user.email.toLowerCase(), password:'', role:'super_admin', approved:true, createdAt:Date.now(), uid:user.uid}; await db.ref('users/'+user.uid).set(data); } currentUserData=data; showApp(data); startListeners(); }catch(e){} }
async function doStaffLogin(){ let name=document.getElementById('staffName').value.trim(); let pass=document.getElementById('staffPassword').value.trim(); let err=document.getElementById('authError'); err.classList.add('hidden'); try{ let snap=await db.ref('users').once('value'); let users=snap.val()||{}; let found=null,foundUid=null; Object.keys(users).forEach(uid=>{ let u=users[uid]; if((u.actualName&&u.actualName.toLowerCase()===name.toLowerCase()&&u.password===pass)||(u.name&&u.name.toLowerCase()===name.toLowerCase()&&u.password===pass)){ found=u; foundUid=uid; } }); if(!found){ err.textContent='Invalid name or password! Contact Super Admin.'; err.classList.remove('hidden'); return; } if(!found.approved){ err.textContent='Account not approved yet.'; err.classList.remove('hidden'); return; } found.uid=foundUid; currentUserData=found; localStorage.setItem('sacco_staff_session', JSON.stringify(found)); showApp(found); startListeners(); logAction('STAFF_LOGIN','Staff login: '+found.actualName); }catch(e){ err.textContent='Error: '+e.message; err.classList.remove('hidden'); } }
function showApp(userData){ document.getElementById('loginScreen').classList.add('hidden'); document.getElementById('appScreen').classList.remove('hidden'); document.getElementById('sideName').textContent=userData.actualName||userData.name; document.getElementById('sideRole').textContent=userData.role; document.getElementById('cpName').textContent=userData.actualName||userData.name; document.getElementById('cpRole').textContent=userData.role; document.getElementById('dashInfo').innerHTML = userData.role==='super_admin' ? '👑 SUPER ADMIN: Grant access with Actual Name + Password. Users can change password anytime.' : '🔒 Staff: '+userData.actualName+' - Role: '+userData.role; let btnUsers=document.getElementById('btnUsers'),btnLogs=document.getElementById('btnLogs'); if(userData.role==='super_admin'){ btnUsers.classList.remove('hidden'); btnLogs.classList.remove('hidden'); } else { btnUsers.classList.add('hidden'); btnLogs.classList.add('hidden'); } showModule('dashboard'); }
function doLogout(){ logAction('LOGOUT','Logout: '+(currentUserData?currentUserData.actualName:'unknown')); if(auth.currentUser) auth.signOut(); localStorage.removeItem('sacco_staff_session'); location.reload(); }
function showModule(id){ if((id==='users'||id==='logs')&&currentUserData.role!=='super_admin'){ alert('ONLY SUPER ADMIN!'); return; } document.querySelectorAll('.module').forEach(m=> m.classList.add('hidden')); document.getElementById('mod-'+id).classList.remove('hidden'); if(id==='logs') loadLogs(); }
function logAction(action,details){ try{ let log={timestamp:Date.now(), timeStr:new Date().toLocaleString(), uid: currentUserData?currentUserData.uid:'unknown', name: currentUserData?currentUserData.actualName:'unknown', email: currentUserData?currentUserData.email:'', action:action, details:details}; db.ref('logs').push(log); }catch(e){} }
function startListeners(){ ['members','shares','savings','loans','repayments','expenses'].forEach(c=>{ db.ref(c).on('value', snap=>{ let val=snap.val(),arr=[]; if(val) Object.keys(val).forEach(k=>{ arr.push({id:k, ...val[k]}); }); store[c]=arr; renderAll(); }); }); db.ref('users').on('value', snap=>{ store.users=snap.val()||{}; renderUsers(); }); }
function fbAdd(colName,data){ let key=db.ref().child(colName).push().key; db.ref(colName+'/'+key).set({...data, createdBy: currentUserData.actualName||currentUserData.name, createdByUid: currentUserData.uid}); logAction('CREATE_'+colName.toUpperCase(), 'Created '+colName+': '+JSON.stringify(data).substring(0,150)); }
function fbDelete(colName,docId){ db.ref(colName+'/'+docId).remove(); logAction('DELETE_'+colName.toUpperCase(), 'Deleted '+colName+' ID: '+docId); }
function addMember(){ let name=document.getElementById('memName').value.trim(),phone=document.getElementById('memPhone').value.trim(),nin=document.getElementById('memNIN').value.trim(),kin=document.getElementById('memNextKin').value.trim(); if(!name) return alert('Enter name'); let memNo='MEM'+String((store.members.length||0)+1).padStart(4,'0'); fbAdd('members',{memNo,name,phone,nin,kin}); document.getElementById('memName').value=''; document.getElementById('memPhone').value=''; document.getElementById('memNIN').value=''; document.getElementById('memNextKin').value=''; }
function delMember(id){ if(confirm('Delete?')) fbDelete('members',id); }
function addShare(){ let mem=document.getElementById('shareMember').value,qty=parseInt(document.getElementById('shareQty').value)||0,price=parseInt(document.getElementById('sharePrice').value)||20000; if(!mem||!qty) return alert('Select'); fbAdd('shares',{mem,qty,price,total:qty*price}); document.getElementById('shareQty').value=''; }
function delShare(id){ fbDelete('shares',id); }
function addSaving(){ let mem=document.getElementById('savMember').value,type=document.getElementById('savType').value,amount=parseInt(document.getElementById('savAmount').value)||0; if(!mem||!amount) return alert('Select'); fbAdd('savings',{mem,type,amount}); document.getElementById('savAmount').value=''; }
function delSav(id){ fbDelete('savings',id); }
function addLoan(){ let mem=document.getElementById('loanMember').value,type=document.getElementById('loanType').value,amount=parseInt(document.getElementById('loanAmount').value)||0,rate=parseInt(document.getElementById('loanRate').value)||10,duration=parseInt(document.getElementById('loanDuration').value)||1,guarantor=document.getElementById('loanGuarantor').value.trim(),collateral=document.getElementById('loanCollateral').value.trim(); if(!mem||!amount) return alert('Select'); let interest=amount*rate/100*duration,total=amount+interest,loanNo='LOAN'+String((store.loans.length||0)+1).padStart(4,'0'); fbAdd('loans',{loanNo,mem,type,amount,rate,duration,interest,total,guarantor,collateral,status:'Approved',balance:total}); document.getElementById('loanAmount').value=''; }
function delLoan(id){ fbDelete('loans',id); }
function addRepay(){ let loanNo=document.getElementById('repayLoan').value,amount=parseInt(document.getElementById('repayAmount').value)||0; if(!loanNo||!amount) return alert('Select'); let loan=store.loans.find(l=> l.loanNo===loanNo); if(!loan) return alert('Not found'); let newBal=Math.max(0,(loan.balance||loan.total||0)-amount); db.ref('loans/'+loan.id+'/balance').set(newBal); fbAdd('repayments',{loanNo,mem:loan.mem,amount,date:new Date().toLocaleDateString()}); document.getElementById('repayAmount').value=''; }
function delRepay(id){ fbDelete('repayments',id); }
function addExpense(){ let title=document.getElementById('expTitle').value.trim(),amount=parseInt(document.getElementById('expAmount').value)||0; if(!title||!amount) return alert('Enter'); fbAdd('expenses',{title,amount,date:new Date().toLocaleDateString()}); document.getElementById('expTitle').value=''; document.getElementById('expAmount').value=''; }
function delExp(id){ fbDelete('expenses',id); }
function renderMembers(){ let tb=document.getElementById('memTable'); if(!tb) return; tb.innerHTML=(store.members||[]).map(m=> `<tr class="border-b"><td class="p-2">${m.memNo||''} - ${m.name||''} - ${m.phone||''}</td><td class="p-2 text-center">${m.nin||''}</td><td class="p-2 text-center"><button onclick="delMember('${m.id}')" class="bg-red-500 text-white px-2 py-1 rounded text-xs">Del</button></td></tr>`).join(''); document.getElementById('dashMembers').textContent=(store.members||[]).length; ['shareMember','savMember','loanMember'].forEach(sid=>{ let sel=document.getElementById(sid); if(sel) sel.innerHTML='<option value="">Select Member</option>'+(store.members||[]).map(m=> `<option value="${m.memNo}">${m.memNo} - ${m.name}</option>`).join(''); }); }
function renderShares(){ let tb=document.getElementById('shareTable'); if(!tb) return; tb.innerHTML=(store.shares||[]).map(s=> `<tr class="border-b"><td class="p-2">${s.mem}</td><td class="p-2 text-center">${s.qty}</td><td class="p-2 text-center">UGX ${(s.total||0).toLocaleString()}</td><td class="p-2 text-center"><button onclick="delShare('${s.id}')" class="bg-red-500 text-white px-2 py-1 rounded text-xs">Del</button></td></tr>`).join(''); }
function renderSavings(){ let tb=document.getElementById('savTable'); if(!tb) return; tb.innerHTML=(store.savings||[]).map(s=> `<tr class="border-b"><td class="p-2">${s.mem}</td><td class="p-2 text-center">${s.type}</td><td class="p-2 text-center">UGX ${(s.amount||0).toLocaleString()}</td><td class="p-2 text-center"><button onclick="delSav('${s.id}')" class="bg-red-500 text-white px-2 py-1 rounded text-xs">Del</button></td></tr>`).join(''); let total=(store.savings||[]).reduce((a,b)=> a+(b.amount||0),0); document.getElementById('dashSavings').textContent='UGX '+total.toLocaleString(); calcProfit(); }
function renderLoans(){ let tb=document.getElementById('loanTable'); if(!tb) return; tb.innerHTML=(store.loans||[]).map(l=> `<tr class="border-b"><td class="p-2">${l.loanNo||''} - ${l.mem||''}</td><td class="p-2 text-center">${l.type||''}</td><td class="p-2 text-center">UGX ${(l.amount||0).toLocaleString()} Bal ${(l.balance||0).toLocaleString()}</td><td class="p-2 text-center"><button onclick="document.getElementById('repayLoan').value='${l.loanNo}'; showModule('repay')" class="bg-green-500 text-white px-2 py-1 rounded text-xs">Pay</button><button onclick="delLoan('${l.id}')" class="bg-red-500 text-white px-2 py-1 rounded text-xs">Del</button></td></tr>`).join(''); let total=(store.loans||[]).reduce((a,b)=> a+(b.total||0),0); document.getElementById('dashLoans').textContent='UGX '+total.toLocaleString(); let sel=document.getElementById('repayLoan'); if(sel) sel.innerHTML='<option value="">Select Loan</option>'+(store.loans||[]).map(l=> `<option value="${l.loanNo}">${l.loanNo} - ${l.mem} - Bal ${(l.balance||0).toLocaleString()}</option>`).join(''); calcProfit(); }
function renderRepay(){ let tb=document.getElementById('repayTable'); if(!tb) return; tb.innerHTML=(store.repayments||[]).map(r=> `<tr class="border-b"><td class="p-2">${r.loanNo||''} - ${r.mem||''}</td><td class="p-2 text-center">UGX ${(r.amount||0).toLocaleString()}</td><td class="p-2 text-center">${r.date||''}</td><td class="p-2 text-center"><button onclick="delRepay('${r.id}')" class="bg-red-500 text-white px-2 py-1 rounded text-xs">Del</button></td></tr>`).join(''); }
function renderExpenses(){ let tb=document.getElementById('expTable'); if(!tb) return; tb.innerHTML=(store.expenses||[]).map(e=> `<tr class="border-b"><td class="p-2">${e.title||''}</td><td class="p-2 text-center">UGX ${(e.amount||0).toLocaleString()}</td><td class="p-2 text-center">${e.date||''}</td><td class="p-2 text-center"><button onclick="delExp('${e.id}')" class="bg-red-500 text-white px-2 py-1 rounded text-xs">Del</button></td></tr>`).join(''); calcProfit(); }
function renderUsers(){ let tb=document.getElementById('usersTable'); if(!tb) return; let users=Object.values(store.users||{}); tb.innerHTML=users.map(u=> `<tr class="border-b"><td class="p-2">${u.actualName||u.name||''} - ${u.email||''} - ${u.role} - ${u.approved?'<span class="bg-green-100 px-2 rounded">Approved</span>':'<span class="bg-yellow-100 px-2 rounded">Pending</span>'} - Pass: ${u.password||''}</td><td class="p-2"><div class="flex gap-1 flex-wrap"><button onclick="approveUser('${u.uid}')" class="bg-green-600 text-white px-2 py-1 rounded text-xs">Approve</button><button onclick="revokeUser('${u.uid}')" class="bg-yellow-600 text-white px-2 py-1 rounded text-xs">Revoke</button><select onchange="changeRole('${u.uid}', this.value)" class="border p-1 rounded text-xs"><option>${u.role}</option><option>cashier</option><option>loans_officer</option><option>manager</option><option>admin</option><option>super_admin</option></select><button onclick="deleteUser('${u.uid}')" class="bg-red-600 text-white px-2 py-1 rounded text-xs">Delete</button></div></td></tr>`).join(''); }
function calcProfit(){ let inc=(store.savings||[]).reduce((a,b)=> a+(b.amount||0),0)+(store.shares||[]).reduce((a,b)=> a+(b.total||0),0)+(store.loans||[]).reduce((a,b)=> a+(b.interest||0),0)+(store.repayments||[]).reduce((a,b)=> a+(b.amount||0),0); let exp=(store.expenses||[]).reduce((a,b)=> a+(b.amount||0),0); document.getElementById('dashProfit').textContent='UGX '+(inc-exp).toLocaleString(); let si=document.getElementById('stIncome'); if(si) si.textContent='UGX '+inc.toLocaleString(); let se=document.getElementById('stExp'); if(se) se.textContent='UGX '+exp.toLocaleString(); let sp=document.getElementById('stProfit'); if(sp) sp.textContent='UGX '+(inc-exp).toLocaleString(); }
function createUser(){ if(currentUserData.role!=='super_admin'){ alert('Only Super Admin!'); return; } let name=document.getElementById('newUserName').value.trim(),email=document.getElementById('newUserEmail').value.trim().toLowerCase(),pass=document.getElementById('newUserPass').value.trim(),role=document.getElementById('newUserRole').value; if(!name||!pass){ alert('Enter actual name and password!'); return; } let uid=db.ref().child('users').push().key; let userData={uid:uid, actualName:name, name:name, email:email, password:pass, role:role, approved:true, createdAt:Date.now(), createdBy: currentUserData.actualName}; db.ref('users/'+uid).set(userData); document.getElementById('newUserName').value=''; document.getElementById('newUserEmail').value=''; document.getElementById('newUserPass').value=''; logAction('USER_CREATED','Created user: '+name+' Role: '+role); alert('✅ User Created! Name: '+name+' Password: '+pass); }
function approveUser(uid){ db.ref('users/'+uid+'/approved').set(true); logAction('USER_APPROVED','Approved UID: '+uid); }
function revokeUser(uid){ db.ref('users/'+uid+'/approved').set(false); logAction('USER_REVOKED','Revoked UID: '+uid); }
function changeRole(uid,role){ db.ref('users/'+uid+'/role').set(role); logAction('ROLE_CHANGE','Changed role UID: '+uid+' to '+role); }
function deleteUser(uid){ if(confirm('Delete user?')){ db.ref('users/'+uid).remove(); logAction('USER_DELETED','Deleted UID: '+uid); } }
function changeOwnPassword(){ let cur=document.getElementById('cpCurrent').value.trim(),nw=document.getElementById('cpNew').value.trim(),conf=document.getElementById('cpConfirm').value.trim(),err=document.getElementById('cpError'),suc=document.getElementById('cpSuccess'); err.classList.add('hidden'); suc.classList.add('hidden'); if(!cur||!nw||!conf){ err.textContent='Fill all'; err.classList.remove('hidden'); return; } if(nw!==conf){ err.textContent='Do not match'; err.classList.remove('hidden'); return; } if(currentUserData.role!=='super_admin'&&currentUserData.password!==cur){ err.textContent='Current password wrong!'; err.classList.remove('hidden'); return; } if(currentUserData.role==='super_admin'&&auth.currentUser){ auth.currentUser.updatePassword(nw).then(()=>{ suc.textContent='✅ Super Admin password changed!'; suc.classList.remove('hidden'); logAction('PASSWORD_CHANGE','Super admin changed password'); }).catch(e=>{ err.textContent=e.message; err.classList.remove('hidden'); }); } else { db.ref('users/'+currentUserData.uid+'/password').set(nw); currentUserData.password=nw; localStorage.setItem('sacco_staff_session', JSON.stringify(currentUserData)); suc.textContent='✅ Password changed! New: '+nw; suc.classList.remove('hidden'); logAction('PASSWORD_CHANGE','User '+currentUserData.actualName+' changed password'); } }
function loadLogs(){ db.ref('logs').orderByChild('timestamp').limitToLast(100).once('value', snap=>{ let val=snap.val(),arr=[]; if(val) Object.keys(val).forEach(k=>{ arr.push(val[k]); }); arr.sort((a,b)=> b.timestamp-a.timestamp); let tb=document.getElementById('logsTable'); tb.innerHTML=arr.map(l=> `<tr class="border-b"><td class="p-2">${l.timeStr}</td><td class="p-2">${l.name} ${l.email?'<br>'+l.email:''}</td><td class="p-2"><span class="bg-gray-100 px-1 rounded">${l.action}</span></td><td class="p-2">${l.details}</td></tr>`).join(''); }); }
function clearLogs(){ if(confirm('Clear logs?')){ db.ref('logs').remove(); logAction('LOGS_CLEARED','Cleared logs'); } }
function exportLogs(){ db.ref('logs').once('value', snap=>{ let val=snap.val(),csv='Time,Name,Email,Action,Details\n'; if(val) Object.values(val).forEach(l=>{ csv+=`"${l.timeStr}","${l.name||''}","${l.email||''}","${l.action}","${(l.details||'').replace(/"/g,'""')}"\n`; }); let blob=new Blob([csv], {type:'text/csv'}),url=URL.createObjectURL(blob),a=document.createElement('a'); a.href=url; a.download='sacco_logs_'+Date.now()+'.csv'; a.click(); }); }
function renderAll(){ renderMembers(); renderShares(); renderSavings(); renderLoans(); renderRepay(); renderExpenses(); renderUsers(); }
window.onload=()=>{ initFirebase(); let sess=localStorage.getItem('sacco_staff_session'); if(sess){ try{ let u=JSON.parse(sess); currentUserData=u; showApp(u); startListeners(); }catch(e){} } };
</script>
</body>
