<!DOCTYPE html>
<html>
<head>
<title>ALLAN SACCO SYSTEM .0</title>
<style>
body{font-family:Arial;background:#f2f2f2;margin:0}
header{background:#0b3d91;color:white;padding:15px;display:flex;justify-content:space-between}
nav{background:#fff;padding:10px;display:flex;gap:10px;flex-wrap:wrap}
button{padding:8px 14px;cursor:pointer;border:none;border-radius:5px;background:#0b3d91;color:#fff}
.card{background:#fff;margin:15px;padding:15px;border-radius:8px}
table{width:100%;border-collapse:collapse}
th,td{border:1px solid #ddd;padding:8px;text-align:left}
th{background:#0b3d91;color:#fff}
input,select{padding:8px;margin:5px;width:200px}
.hidden{display:none}
@media print{header,nav,.no-print{display:none!important} .card{box-shadow:none}}
</style>
</head>
<body>
<header><b>SACCO SYSTEM.0</b><span id="userInfo">Logged in: allan128 - SUPER ADMIN</span></header>
<nav class="no-print">
<button onclick="show('dashboard')">Dashboard</button>
<button onclick="show('shares')">Shares</button>
<button onclick="show('reports')">Reports</button>
<button onclick="show('activity')">Activity Log - Everyone Can View</button>
<button id="loginBtn" onclick="show('loginHistory')">Login History - Super Admin Only</button>
<button onclick="show('users')">Users & Rights</button>
<button onclick="window.print()">Print Receipt</button>
</nav>

<!-- DASHBOARD -->
<div id="dashboard" class="card"><h2>Dashboard</h2><p>Total Members: <span id="totalMembers">0</span> | Total Shares: <span id="totalShares">0</span></p></div>

<!-- SHARES + SELL / TRANSFER -->
<div id="shares" class="card hidden">
<h2>Shares Module - Sell / Transfer</h2>
<h3>Add Shares</h3>
Member: <select id="shareMember"><option>Peter - MEM001</option><option>Mary - MEM002</option><option>John - MEM003</option></select>
Shares: <input type="number" id="shareQty" placeholder="No. of shares">
<button onclick="addShares()">Add Shares</button>

<h3>Sell Shares</h3>
Seller: <select id="seller"><option>Peter - MEM001</option><option>Mary - MEM002</option></select>
Buyer: <select id="buyer"><option>Mary - MEM002</option><option>John - MEM003</option></select>
Shares to Sell: <input type="number" id="sellQty" value="10">
Price per Share: <input type="number" id="sellPrice" value="20000">
<button onclick="sellShares()">Sell Shares - Needs Super Admin Approval</button>

<h3>Transfer Shares</h3>
From: <select id="fromM"><option>Peter - MEM001</option><option>Mary - MEM002</option></select>
To: <select id="toM"><option>John - MEM003</option><option>Mary - MEM002</option></select>
Shares: <input type="number" id="transferQty" value="5">
Reason: <input id="transferReason" placeholder="Gift / Family / Exit">
<button onclick="transferShares()">Transfer Shares</button>

<table><tr><th>Member</th><th>Shares</th><th>Value</th></tr><tbody id="shareTable"></tbody></table>
</div>

<!-- REPORTS -->
<div id="reports" class="card hidden">
<h2>Reports Module</h2>
Filter Date: <input type="date"> to <input type="date"> <button onclick="window.print()">Print Report</button>
<h3>1. Shares Report</h3><div id="reportShares"></div>
<h3>2. Loan Status Per Member</h3>
<table><tr><th>Member</th><th>Loan</th><th>Paid</th><th>Balance</th><th>Status</th></tr>
<tr><td>Peter</td><td>500,000</td><td>300,000</td><td>200,000</td><td>Active</td></tr>
<tr><td>Mary</td><td>1,000,000</td><td>1,000,000</td><td>0</td><td>Cleared</td></tr></table>
<h3>3. Loan Repayment Report</h3><p>Peter paid 100,000 on 12/11/2026 - Balance 200,000 - Received by Mary</p>
<h3>4. Expenses Status</h3><p>Total Expenses Nov: 450,000 - Rent 300,000 - Airtime 50,000 - Transport 100,000</p>
<h3>5. Staff Status</h3>
<table><tr><th>Staff</th><th>Role</th><th>Last Login</th><th>Status</th></tr>
<tr><td>Mary</td><td>Cashier</td><td>12/11/2026 09:00</td><td>Active</td></tr>
<tr><td>John</td><td>Loans Officer</td><td>12/11/2026 08:30</td><td>Active</td></tr></table>
</div>

<!-- ACTIVITY LOG - VISIBLE TO ALL -->
<div id="activity" class="card hidden">
<h2>Activity Log - All Changes Visible To Everyone</h2>
<p>No one can delete this log. Only Super Admin can view Login History.</p>
<table><tr><th>Date/Time</th><th>Who</th><th>What They Did</th></tr><tbody id="activityTable"></tbody></table>
</div>

<!-- LOGIN HISTORY - SUPER ADMIN ONLY -->
<div id="loginHistory" class="card hidden">
<h2>Login History - SUPER ADMIN ONLY</h2>
<table><tr><th>User</th><th>Role</th><th>Date</th><th>Time</th><th>Device/IP</th><th>Status</th></tr>
<tr><td>allan128</td><td>Super Admin</td><td>12/11/2026</td><td>08:02 AM</td><td>DESKTOP-JEMO</td><td>Success</td></tr>
<tr><td>mary12</td><td>Cashier</td><td>12/11/2026</td><td>09:00 AM</td><td>DESKTOP-02</td><td>Failed - Wrong Password</td></tr></table>
</div>

<!-- USERS & PERMISSIONS -->
<div id="users" class="card hidden">
<h2>Users & Rights - Only Super Admin Can Grant Access / Delete</h2>
<table><tr><th>User</th><th>Role</th><th>Can Add/Edit</th><th>Can Delete</th><th>Can Grant Access</th></tr>
<tr><td>allan128</td><td>Super Admin</td><td>YES</td><td>YES - ONLY YOU</td><td>YES - ONLY YOU</td></tr>
<tr><td>Mary</td><td>Cashier - Limited</td><td>YES</td><td>NO</td><td>NO</td></tr>
<tr><td>John</td><td>Loans Officer - Limited</td><td>YES</td><td>NO</td><td>NO</td></tr></table>
<p>Rule: Staff/Members CAN add, edit, add people, add items. They CANNOT delete. Some members are limited - e.g. Cashier cannot see Staff or Expenses.</p>
<button onclick="alert('Only Super Admin can delete. Request sent to allan128 for approval.')">Try Delete (Staff) - Will Be Blocked</button>
</div>

<!-- RECEIPT - PRINTABLE ON ALL MODULES -->
<div id="receipt" class="card">
<h2>Printable Receipt - For All Modules</h2>
<div id="printArea" style="border:1px dashed #000;padding:15px;max-width:400px">
<center><b>YOUR SACCO NAME</b><br>Kampala | Tel: 077X XXX XXX<br>--------------------------------</center>
Receipt No: <b id="receiptNo">REC-00123</b><br>
Date: 12/11/2026 Time: 09:30 AM<br>
Received From: <span id="receiptName">Peter - MEM001</span><br>
Transaction: <span id="receiptType">Shares / Savings / Loan Repayment</span><br>
Amount: UGX <b id="receiptAmount">200,000</b><br>
Amount in Words: Two Hundred Thousand Only<br>
Payment: Cash / Mobile Money<br>
Balance After: UGX 1,500,000<br>
Received By: <span id="receiptBy">Mary - Cashier</span><br>
<center>--------------------------------<br>Signature: ___________<br>THANK YOU FOR SAVING WITH US!</center>
</div><br>
<button class="no-print" onclick="window.print()">Print This Receipt</button>
</div>

<script>
let shares = {Peter:100, Mary:50, John:20};
let currentUser = "allan128"; // Change to mary12 to test limited rights
let role = "Super Admin"; // Change to Cashier to test

function show(id){
  document.querySelectorAll('.card').forEach(c=>c.classList.add('hidden'));
  document.getElementById(id).classList.remove('hidden');
  document.getElementById('receipt').classList.remove('hidden');
  // SUPER ADMIN ONLY CHECK
  if(id==='loginHistory' && role!=='Super Admin'){
    alert('ACCESS DENIED: Login History is for Super Admin ONLY');
    return;
  }
  if(id==='users' && role!=='Super Admin'){
    alert('Only Super Admin can manage Users & Rights');
  }
}
function logActivity(text){
  let row = `<tr><td>${new Date().toLocaleString()}</td><td>${currentUser} (${role})</td><td>${text}</td></tr>`;
  document.getElementById('activityTable').innerHTML += row;
  // Everyone can see this, no one can delete it
}
function addShares(){
  let m=document.getElementById('shareMember').value.split(' - ')[0];
  let q=parseInt(document.getElementById('shareQty').value||0);
  shares[m]+=q; updateShares(); logActivity(`Added ${q} shares to ${m}`);
  document.getElementById('receiptAmount').innerText=(q*20000).toLocaleString();
  document.getElementById('receiptType').innerText='Shares Purchase';
  alert('Shares added + Receipt ready to print + Logged for everyone to see');
}
function sellShares(){
  let s=document.getElementById('seller').value.split(' - ')[0];
  let b=document.getElementById('buyer').value.split(' - ')[0];
  let q=parseInt(document.getElementById('sellQty').value);
  let p=parseInt(document.getElementById('sellPrice').value);
  if(role!=='Super Admin'){ alert('Sell request sent to Super Admin for approval. You cannot approve yourself.'); logActivity(`${s} requested to sell ${q} shares to ${b} for ${q*p} - Pending Approval`); return; }
  shares[s]-=q; shares[b]+=q; updateShares(); logActivity(`${s} sold ${q} shares to ${b} for UGX ${q*p}`);
  document.getElementById('receiptAmount').innerText=(q*p).toLocaleString();
  alert('Sale approved by Super Admin + Receipt generated');
}
function transferShares(){
  let f=document.getElementById('fromM').value.split(' - ')[0];
  let t=document.getElementById('toM').value.split(' - ')[0];
  let q=parseInt(document.getElementById('transferQty').value);
  shares[f]-=q; shares[t]+=q; updateShares(); logActivity(`${f} transferred ${q} shares to ${t} - Reason: ${document.getElementById('transferReason').value}`);
  alert('Transfer done + Logged');
}
function updateShares(){
  let html=''; let total=0;
  for(let k in shares){ html+=`<tr><td>${k}</td><td>${shares[k]}</td><td>${(shares[k]*20000).toLocaleString()}</td></tr>`; total+=shares[k]; }
  document.getElementById('shareTable').innerHTML=html;
  document.getElementById('totalShares').innerText=total;
  document.getElementById('reportShares').innerHTML=`Total Shares: ${total} - Value: UGX ${(total*20000).toLocaleString()}`;
}
updateShares(); logActivity('allan128 logged in as Super Admin');
show('dashboard');
</script>
</body>
</html>
