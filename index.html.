<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Allan SACCO - Final</title>
<style>
*{box-sizing:border-box;font-family:Arial,sans-serif}
body{margin:0;background:#f1f5f9}
header{background:#0f172a;color:#fff;padding:15px 20px;display:flex;justify-content:space-between;align-items:center}
header b{font-size:20px}
nav{display:flex;gap:8px;background:#fff;padding:10px;flex-wrap:wrap;box-shadow:0 2px 5px #0001}
nav button{padding:10px 14px;border:none;background:#e2e8f0;border-radius:8px;cursor:pointer;font-weight:bold}
nav button.active{background:#0f172a;color:#fff}
.card{background:#fff;margin:15px;padding:18px;border-radius:12px;box-shadow:0 2px 8px #0001}
input,select{width:100%;padding:11px;margin:6px 0;border:1px solid #cbd5e1;border-radius:8px}
.btn{background:#16a34a;color:#fff;border:none;padding:11px 16px;border-radius:8px;cursor:pointer;font-weight:bold}
.btn-blue{background:#2563eb}.btn-red{background:#dc2626}.btn-dark{background:#0f172a}
table{width:100%;border-collapse:collapse;margin-top:10px}
th,td{padding:10px;border-bottom:1px solid #e2e8f0;text-align:left;font-size:14px}
.hidden{display:none}
.badge{padding:4px 8px;border-radius:20px;font-size:12px;color:#fff}
.green{background:#16a34a}.orange{background:#f59e0b}.blue{background:#2563eb}
#loginBox{max-width:400px;margin:80px auto;background:#fff;padding:25px;border-radius:14px;box-shadow:0 5px 20px #0002}
</style>
</head>
<body>

<header><b>🏦 ALLAN SACCO</b><span id="userInfo"></span><button class="btn btn-red hidden" id="logoutBtn" onclick="logout()">Logout</button></header>

<!-- LOGIN -->
<div id="loginBox">
  <h2>Login</h2>
  <p>Use your name as registered, e.g. <b>allan amon</b></p>
  <input id="loginName" placeholder="Enter your full name - e.g. allan amon">
  <input id="loginPass" type="password" placeholder="Password">
  <button class="btn btn-dark" style="width:100%" onclick="doLogin()">Login</button>
  <p id="loginMsg" style="color:red"></p>
</div>

<!-- APP -->
<div id="app" class="hidden">
<nav>
  <button onclick="show('dashboard')" id="n-dashboard" class="active">📊 Dashboard</button>
  <button onclick="show('members')" id="n-members">👥 Members</button>
  <button onclick="show('savings')" id="n-savings">💰 Savings</button>
  <button onclick="show('loans')" id="n-loans">🏦 Loans</button>
  <button onclick="show('logs')" id="n-logs">📜 Log History</button>
</nav>

<!-- DASHBOARD -->
<div id="page-dashboard" class="card">
  <h2>Dashboard</h2>
  <p>Welcome <b id="welcomeName"></b> | Role: <b id="welcomeRole"></b></p>
  <p>Total Members: <b id="statMembers">0</b> | Total Savings: <b id="statSavings">0 UGX</b> | Total Loans: <b id="statLoans">0 UGX</b> | Logs: <b id="statLogs">0</b></p>
</div>

<!-- MEMBERS -->
<div id="page-members" class="card hidden">
  <h2>Members</h2>
  <input id="mName" placeholder="Member Full Name">
  <input id="mPhone" placeholder="Phone e.g. 0770...">
  <button class="btn" onclick="addMember()">+ Add Member</button>
  <table><thead><tr><th>Name</th><th>Phone</th><th>Date</th><th>Action</th></tr></thead><tbody id="membersList"></tbody></table>
</div>

<!-- SAVINGS -->
<div id="page-savings" class="card hidden">
  <h2>Savings / Deposit</h2>
  <select id="sMember"></select>
  <input id="sAmount" type="number" placeholder="Amount UGX">
  <button class="btn" onclick="addSaving()">Deposit Saving</button>
  <table><thead><tr><th>Member</th><th>Amount</th><th>Date</th><th>By</th></tr></thead><tbody id="savingsList"></tbody></table>
</div>

<!-- LOANS -->
<div id="page-loans" class="card hidden">
  <h2>Loans</h2>
  <select id="lMember"></select>
  <input id="lAmount" type="number" placeholder="Loan Amount UGX">
  <button class="btn btn-blue" onclick="addLoan()">Request Loan</button>
  <table><thead><tr><th>Member</th><th>Amount</th><th>Status</th><th>Action</th></tr></thead><tbody id="loansList"></tbody></table>
</div>

<!-- LOGS -->
<div id="page-logs" class="card hidden">
  <h2>📜 Log History - All Modules</h2>
  <div style="display:flex;gap:8px">
    <select id="logFilter" onchange="renderLogs()"><option value="ALL">All Modules</option><option value="AUTH">AUTH</option><option value="MEMBERS">MEMBERS</option><option value="SAVINGS">SAVINGS</option><option value="LOANS">LOANS</option><option value="SYSTEM">SYSTEM</option></select>
    <input id="logSearch" placeholder="Search logs..." oninput="renderLogs()">
  </div>
  <button class="btn btn-red" onclick="clearLogs()" style="margin-top:8px">Clear All Logs (Admin)</button>
  <table><thead><tr><th>Date</th><th>Module</th><th>Action</th><th>User</th><th>Details</th></tr></thead><tbody id="logsList"></tbody></table>
</div>
</div>

<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>
<script>
const firebaseConfig = {
  apiKey: "YOUR_API_KEY",
  authDomain: "allan-sacco.firebaseapp.com",
  databaseURL: "https://allan-sacco-default-rtdb.firebaseio.com",
  projectId: "allan-sacco",
  storageBucket: "allan-sacco.appspot.com",
  messagingSenderId: "YOUR_SENDER_ID",
  appId: "YOUR_APP_ID"
};
firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.database();

let currentUser = null, currentProfile = null;
let allMembers = {}, allSavings = {}, allLoans = {}, allLogs = {};

// ===== LOG HISTORY - CORE FUNCTION =====
function addLog(module, action, details){
  if(!currentUser) return;
  const log = {
    module: module,
    action: action,
    details: details || "",
    user: currentProfile ? currentProfile.actualName : currentUser.email,
    email: currentUser.email,
    timestamp: Date.now(),
    date: new Date().toLocaleString()
  };
  db.ref('logs').push(log);
}
// Log every page view too
function logView(module){ addLog(module, 'VIEWED_PAGE', 'Opened '+module+' module'); }

function show(page){
  document.querySelectorAll('[id^="page-"]').forEach(e=>e.classList.add('hidden'));
  document.getElementById('page-'+page).classList.remove('hidden');
  document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));
  document.getElementById('n-'+page).classList.add('active');
  logView(page.toUpperCase());
  if(page==='logs') renderLogs();
}

// ===== LOGIN WITH nameToEmail (YOUR FIX) =====
async function doLogin(){
  const name = document.getElementById('loginName').value.trim().toLowerCase();
  const pass = document.getElementById('loginPass').value;
  const msg = document.getElementById('loginMsg');
  if(!name || !pass){ msg.textContent="Enter name and password"; return; }
  msg.textContent="Checking...";
  try{
    const snap = await db.ref('nameToEmail/'+name).once('value');
    const email = snap.val();
    if(!email){ msg.textContent="Name not found. Ask admin to add you in nameToEmail."; return; }
    const cred = await auth.signInWithEmailAndPassword(email, pass);
    currentUser = cred.user;
    const prof = await db.ref('users/'+currentUser.uid).once('value');
    currentProfile = prof.val();
    if(!currentProfile || !currentProfile.approved){
      msg.textContent="User not approved. Ask admin."; await auth.signOut(); return;
    }
    document.getElementById('loginBox').classList.add('hidden');
    document.getElementById('app').classList.remove('hidden');
    document.getElementById('logoutBtn').classList.remove('hidden');
    document.getElementById('userInfo').textContent = currentProfile.actualName + " ("+currentProfile.role+")";
    document.getElementById('welcomeName').textContent = currentProfile.actualName;
    document.getElementById('welcomeRole').textContent = currentProfile.role;
    addLog('AUTH','LOGIN','User logged in as '+currentProfile.role);
    listenAll();
  }catch(e){ msg.textContent=e.message; }
}
function logout(){ addLog('AUTH','LOGOUT','User logged out'); auth.signOut(); location.reload(); }

// ===== MEMBERS =====
async function addMember(){
  const name=document.getElementById('mName').value.trim();
  const phone=document.getElementById('mPhone').value.trim();
  if(!name) return alert('Enter name');
  const ref=db.ref('members').push();
  await ref.set({name, phone, createdBy: currentProfile.actualName, createdAt: Date.now(), date: new Date().toLocaleString()});
  addLog('MEMBERS','ADD_MEMBER','Added member: '+name+' ('+phone+')');
  document.getElementById('mName').value=''; document.getElementById('mPhone').value='';
}
function deleteMember(id, name){ if(confirm('Delete '+name+'?')){ db.ref('members/'+id).remove(); addLog('MEMBERS','DELETE_MEMBER','Deleted member: '+name); } }

// ===== SAVINGS =====
async function addSaving(){
  const memberId=document.getElementById('sMember').value;
  const amount=Number(document.getElementById('sAmount').value);
  if(!amount) return alert('Enter amount');
  const mName = allMembers[memberId]?.name || memberId;
  await db.ref('savings').push({memberId, memberName:mName, amount, by: currentProfile.actualName, date:new Date().toLocaleString(), timestamp:Date.now()});
  await db.ref('transactions').push({type:'SAVING', memberName:mName, amount, by:currentProfile.actualName, date:new Date().toLocaleString()});
  addLog('SAVINGS','DEPOSIT','Deposited '+amount+' UGX for '+mName);
  document.getElementById('sAmount').value='';
}

// ===== LOANS =====
async function addLoan(){
  const memberId=document.getElementById('lMember').value;
  const amount=Number(document.getElementById('lAmount').value);
  if(!amount) return alert('Enter amount');
  const mName = allMembers[memberId]?.name || memberId;
  const ref=db.ref('loans').push();
  await ref.set({memberId, memberName:mName, amount, status:'PENDING', by:currentProfile.actualName, date:new Date().toLocaleString()});
  addLog('LOANS','REQUEST_LOAN','Requested loan '+amount+' UGX for '+mName);
  document.getElementById('lAmount').value='';
}
function approveLoan(id, mName, amount){
  db.ref('loans/'+id+'/status').set('APPROVED');
  addLog('LOANS','APPROVE_LOAN','Approved loan '+amount+' UGX for '+mName);
}
function rejectLoan(id, mName){
  db.ref('loans/'+id+'/status').set('REJECTED');
  addLog('LOANS','REJECT_LOAN','Rejected loan for '+mName);
}

// ===== LISTENERS =====
function listenAll(){
  db.ref('members').on('value', s=>{ allMembers=s.val()||{}; renderMembers(); });
  db.ref('savings').on('value', s=>{ allSavings=s.val()||{}; renderSavings(); });
  db.ref('loans').on('value', s=>{ allLoans=s.val()||{}; renderLoans(); });
  db.ref('logs').on('value', s=>{ allLogs=s.val()||{}; renderLogs(); updateStats(); });
}
function updateStats(){
  document.getElementById('statMembers').textContent=Object.keys(allMembers).length;
  document.getElementById('statSavings').textContent=Object.values(allSavings).reduce((a,b)=>a+(b.amount||0),0).toLocaleString()+" UGX";
  document.getElementById('statLoans').textContent=Object.values(allLoans).reduce((a,b)=>a+(b.amount||0),0).toLocaleString()+" UGX";
  document.getElementById('statLogs').textContent=Object.keys(allLogs).length;
}
function renderMembers(){
  const tb=document.getElementById('membersList'); tb.innerHTML='';
  const sm=document.getElementById('sMember'), lm=document.getElementById('lMember'); sm.innerHTML=''; lm.innerHTML='';
  Object.entries(allMembers).forEach(([id,m])=>{
    tb.innerHTML+=`<tr><td>${m.name}</td><td>${m.phone||''}</td><td>${m.date||''}</td><td><button class="btn btn-red" onclick="deleteMember('${id}','${m.name}')">Delete</button></td></tr>`;
    sm.innerHTML+=`<option value="${id}">${m.name}</option>`; lm.innerHTML+=`<option value="${id}">${m.name}</option>`;
  });
}
function renderSavings(){
  const tb=document.getElementById('savingsList'); tb.innerHTML='';
  Object.values(allSavings).reverse().forEach(s=>{ tb.innerHTML+=`<tr><td>${s.memberName}</td><td>${s.amount}</td><td>${s.date}</td><td>${s.by}</td></tr>`; });
}
function renderLoans(){
  const tb=document.getElementById('loansList'); tb.innerHTML='';
  Object.entries(allLoans).reverse().forEach(([id,l])=>{
    tb.innerHTML+=`<tr><td>${l.memberName}</td><td>${l.amount}</td><td><span class="badge ${l.status==='APPROVED'?'green':l.status==='REJECTED'?'orange':'blue'}">${l.status}</span></td><td><button class="btn" onclick="approveLoan('${id}','${l.memberName}',${l.amount})">Approve</button> <button class="btn btn-red" onclick="rejectLoan('${id}','${l.memberName}')">Reject</button></td></tr>`;
  });
}
function renderLogs(){
  const tb=document.getElementById('logsList'); if(!tb) return; tb.innerHTML='';
  const filter=document.getElementById('logFilter').value;
  const search=(document.getElementById('logSearch').value||'').toLowerCase();
  Object.values(allLogs).sort((a,b)=>b.timestamp-a.timestamp).forEach(l=>{
    if(filter!=='ALL' && l.module!==filter) return;
    if(search && !(l.details+l.user+l.action).toLowerCase().includes(search)) return;
    const color = l.module==='MEMBERS'?'blue':l.module==='SAVINGS'?'green':l.module==='LOANS'?'orange':'blue';
    tb.innerHTML+=`<tr><td>${l.date}</td><td><span class="badge ${color}">${l.module}</span></td><td>${l.action}</td><td>${l.user}</td><td>${l.details}</td></tr>`;
  });
}
function clearLogs(){ if(currentProfile.role!=='super_admin') return alert('Only super_admin can clear logs'); if(confirm('Clear all logs? This will be logged!')){ addLog('SYSTEM','CLEAR_LOGS','Admin cleared all logs'); setTimeout(()=>db.ref('logs').remove(),500); } }
</script>
</body>
</html>
