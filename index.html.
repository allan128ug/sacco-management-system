<div id="mod-dashboard" class="module"><h1 class="text-2xl font-black mb-2">Dashboard V3.0 SECURE</h1><div id="dashInfo" class="p-3 rounded text-sm mb-4 bg-black text-yellow-300"></div><div class="grid grid-cols-2 md:grid-cols-4 gap-4"><div class="bg-white p-4 rounded-xl shadow"><p class="text-xs">Members</p><p id="dashMembers" class="text-xl font-black">0</p></div><div class="bg-green-600 text-white p-4 rounded-xl shadow"><p class="text-xs">Savings</p><p id="dashSavings" class="text-xl font-black">UGX 0</p></div><div class="bg-yellow-600 text-white p-4 rounded-xl shadow"><p class="text-xs">Loans</p><p id="dashLoans" class="text-xl font-black">UGX 0</p></div><div class="bg-blue-900 text-white p-4 rounded-xl shadow"><p class="text-xs">Profit</p><p id="dashProfit" class="text-xl font-black">UGX 0</p></div></div></div>
<div id="mod-users" class="module hidden"><h1 class="text-xl font-black mb-2">👑 User Management - Super Admin Only</h1><div class="bg-white p-4 rounded-xl shadow mb-4"><h3 class="font-bold text-sm mb-2">Create New User - Give Actual Name + Password</h3><div class="grid grid-cols-1 md:grid-cols-5 gap-2"><input id="newUserName" placeholder="Actual Name e.g., John Doe" class="border p-2 rounded"><input id="newUserEmail" placeholder="Email (optional)" class="border p-2 rounded"><input id="newUserPass" placeholder="Password for user" class="border p-2 rounded"><select id="newUserRole" class="border p-2 rounded"><option>cashier</option><option>loans_officer</option><option>manager</option><option>admin</option><option>super_admin</option></select><button onclick="createUser()" class="bg-black text-white p-2 rounded font-bold">Create & Grant Access</button></div></div><div class="bg-white rounded-xl shadow overflow-auto"><table class="w-full text-sm"><thead class="bg-gray-100"><tr><th class="p-2">Name - Email - Role - Status</th><th class="p-2">Actions</th></tr></thead><tbody id="usersTable"></tbody></table></div></div>
<div id="mod-logs" class="module hidden"><h1 class="text-xl font-black mb-2">📜 Log History - Super Admin Monitoring</h1><div class="bg-white p-4 rounded-xl shadow mb-4 grid grid-cols-1 md:grid-cols-3 gap-2"><button onclick="loadLogs()" class="bg-blue-900 text-white p-2 rounded font-bold">Refresh Logs</button><button onclick="clearLogs()" class="bg-red-600 text-white p-2 rounded font-bold">Clear Logs</button><button onclick="exportLogs()" class="bg-green-600 text-white p-2 rounded font-bold">Export CSV</button></div><div class="bg-white rounded-xl shadow overflow-auto max-h-[600px]"><table class="w-full text-[11px]"><thead class="bg-gray-100 sticky top-0"><tr><th class="p-2 text-left">Time</th><th class="p-2">Name/Email</th><th class="p-2">Action</th><th class="p-2">Details</th></tr></thead><tbody id="logsTable"></tbody></table></div></div>
<div id="mod-changepass" class="module hidden"><h1 class="text-xl font-black mb-4">🔑 Change My Password - Any User Can Change Anytime</h1><div class="bg-white p-6 rounded-xl shadow max-w-md"><div class="bg-blue-50 p-3 rounded mb-4 text-sm"><b>Logged as:</b> <span id="cpName"></span> | Role: <span id="cpRole"></span></div><input id="cpCurrent" type="password" placeholder="Current Password" class="w-full border-2 p-3 rounded-lg mb-3"><input id="cpNew" type="password" placeholder="New Password" class="w-full border-2 p-3 rounded-lg mb-3"><input id="cpConfirm" type="password" placeholder="Confirm New Password" class="w-full border-2 p-3 rounded-lg mb-4"><div id="cpError" class="hidden bg-red-100 text-red-700 p-2 rounded text-sm mb-3"></div><div id="cpSuccess" class="hidden bg-green-100 text-green-700 p-2 rounded text-sm mb-3"></div><button onclick="changeOwnPassword()" class="w-full bg-black text-white p-3 rounded-lg font-black">Change Password Now</button></div></div>
